      "student_formula": "to_digit_after == to_digit_before + 10 AND from_digit_after == from_digit_before",
      "distinguishing_from": ["subtraction_borrowing.borrow_across_zero"]
    },
    "citation": "Brown & Burton (1978), DEBUGGY; VanLehn (1980), Repair Theory",
    "misconception_id": "subtraction_borrowing.no_decrement_after_borrow",
