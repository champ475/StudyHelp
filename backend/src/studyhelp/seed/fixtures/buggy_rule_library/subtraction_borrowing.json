[
  {
    "id": "subtraction_borrowing.smaller_from_larger",
    "topic": "subtraction_with_borrowing",
    "step_type": "subtract_column",
    "bug_code": "B1-smaller-from-larger",
    "signature_matcher": {
      "applies_to": "subtract_column",
      "precondition": { "corresponding_compare_column.borrow_needed": true },
      "student_formula": "result_digit == abs(subtrahend_digit - pre_borrow_minuend_digit) AND minuend_digit == pre_borrow_minuend_digit",
      "distinguishing_from": ["subtraction_borrowing.stale_borrow_digit"]
    },
    "citation": "Brown & Burton (1978), DEBUGGY — the headline catalogued bug; VanLehn (1990), Mind Bugs",
    "misconception_id": "subtraction_borrowing.smaller_from_larger",
    "example_pair": {
      "problem_id": "subtraction-borrow-001",
      "correct_step": {
        "step_type": "subtract_column",
        "fields": { "column": "units", "minuend_digit": 12, "subtrahend_digit": 5, "result_digit": 7 }
      },
      "student_step": {
        "step_type": "subtract_column",
        "fields": { "column": "units", "minuend_digit": 2, "subtrahend_digit": 5, "result_digit": 3 }
      },
      "note": "Student never borrows; subtracts the smaller digit from the larger one in the column regardless of which number (minuend or subtrahend) it belongs to. On 52-25 this produces 33 instead of 27."
    }
  },
  {
