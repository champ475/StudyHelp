      "problem_id": "subtraction-borrow-001",
      "correct_step": {
        "step_type": "borrow",
        "fields": {
          "from_column": "tens", "from_digit_before": 5, "from_digit_after": 4,
          "to_column": "units", "to_digit_before": 2, "to_digit_after": 12
        }
      },
      "student_step": {
        "step_type": "borrow",
        "fields": {
          "from_column": "tens", "from_digit_before": 5, "from_digit_after": 5,
          "to_column": "units", "to_digit_before": 2, "to_digit_after": 12
        }
      },
      "note": "The receiving half of the borrow is correct (units becomes 12), but the lending column is never decremented (tens stays 5 instead of 4) — the student 'borrows' without paying it back."
