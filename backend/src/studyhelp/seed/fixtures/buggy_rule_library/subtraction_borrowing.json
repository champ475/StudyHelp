      "precondition": { "to_digit_before": 0 },
      "student_formula": "(from_digit_after == from_digit_before) OR (to_digit_after == 9)",
      "distinguishing_from": ["subtraction_borrowing.no_decrement_after_borrow"]
    },
    "citation": "Brown & Burton (1978), DEBUGGY — documented borrow-across-zero variant",
    "misconception_id": "subtraction_borrowing.borrow_across_zero",
