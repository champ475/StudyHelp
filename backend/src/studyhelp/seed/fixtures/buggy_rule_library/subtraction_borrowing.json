      "problem_id": "subtraction-borrow-002",
      "correct_step": {
        "step_type": "borrow",
        "fields": {
          "from_column": "hundreds", "from_digit_before": 5, "from_digit_after": 4,
          "to_column": "tens", "to_digit_before": 0, "to_digit_after": 10
        }
      },
      "student_step": {
        "step_type": "borrow",
        "fields": {
