# Copy to .env for local development. Never commit a real .env.
# Twelve-factor: all config via environment variables (CLAUDE.md).

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Postgres (primary datastore) ---
DATABASE_URL=postgresql+asyncpg://studyhelp:studyhelp@localhost:5432/studyhelp

# --- Redis (active per-step dialogue-state cache only; Postgres is durable source of truth) ---
REDIS_URL=redis://localhost:6379/0

# --- LLM provider (provider-agnostic wrapper; see ARCHITECTURE.md D17) ---
# "mock" until a Groq API key is provided. Never assume "groq" works without
# first verifying structured-output/tool-calling reliability for the chosen model.
LLM_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=

# --- Dialogue orchestrator tunables ---
DIALOGUE_TURN_BUDGET=4
READABILITY_MAX_GRADE=5.0
